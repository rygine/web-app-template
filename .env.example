# copy to .env and adjust

# port the service listens on
PORT=3000

# host interface the port is published on - 0.0.0.0 also bypasses ufw
BIND_ADDR=127.0.0.1

# bind address - 0.0.0.0 is required inside a container
HOST=0.0.0.0

# log level for the server - trace | debug | info | warn | error | off
# leave this unset to manage it from the settings page
# LOG_LEVEL=debug

# log level for the browser - baked in at build time, so it has no effect on a
# running container
VITE_LOG_LEVEL=debug

# host development only - the container's paths are pinned in compose.yaml and
# a value here cannot reach it. For the container, pass DATA_PATH and LOGS_PATH,
# or the two arguments to dev/run.sh.

# holds app.db
DATA_DIR=./data

# holds the archive/ directory - the log store itself is a table under DATA_DIR
LOGS_DIR=./logs

# pins the API key - leave unset to manage it from the settings page
# API_KEY=
