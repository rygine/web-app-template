{
  "name": "untitled",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "yarn clean:build && yarn prisma:setup && vite build",
    "build:image": "yarn prisma:generate && vite build",
    "ci": "yarn prisma:generate && yarn build && yarn lint && yarn format:check && yarn test && yarn typecheck && CI=1 yarn test:e2e",
    "clean": "yarn clean:build && yarn clean:generated && rimraf node_modules",
    "clean:agent": "rimraf .superpowers docs",
    "clean:build": "rimraf dist .output .nitro .tanstack playwright-report test-results",
    "clean:generated": "rimraf --glob 'src/**/*.gen.ts' src/generated .tmp",
    "dev": "yarn prisma:setup && vite dev --port 3000",
    "fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:setup": "yarn prisma:generate && yarn prisma:migrate",
    "reset": "yarn clean:agent && rimraf data && yarn clean",
    "start": "yarn build && node .output/server/index.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:docker": "./dev/e2e.sh",
    "test:watch": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@mantine/core": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@mantine/notifications": "^9.7.1",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "dotenv": "^18.0.5",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.3",
    "nitro": "^3.0.260903-beta",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright": "^1.63.0",
    "postcss": "^8.5.29",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=26.8"
  },
  "packageManager": "yarn@4.18.1"
}
